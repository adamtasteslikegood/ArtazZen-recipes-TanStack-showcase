{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/Recipe.schema.json",
  "title": "Recipe (tasteslikegood.org export)",
  "description": "Inferred from a single exported recipe (docs/Crispy_Vegan_Grilled_Cheese_Sandwich copy.json). Only fields seen in that sample are described; optionality beyond 'required' is unverified. Unknown extra fields are allowed until more samples are checked.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Recipe id on the live site."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "prepTime": {
      "type": "number",
      "minimum": 0,
      "description": "Preparation time. Unit not stated in the data; minutes assumed."
    },
    "cookTime": {
      "type": "number",
      "minimum": 0,
      "description": "Cooking time. Unit not stated in the data; minutes assumed."
    },
    "servings": {
      "type": "number",
      "minimum": 0
    },
    "ingredients": {
      "type": "object",
      "description": "Ingredients grouped by kind. Groups seen: dry, wet, other. Other group names may exist.",
      "additionalProperties": {
        "type": "array",
        "items": { "$ref": "#/$defs/ingredient" }
      }
    },
    "instructions": {
      "type": "array",
      "items": { "$ref": "#/$defs/instructionStep" }
    },
    "notes": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "image_keywords": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Keywords used to generate the image. Candidate for alt text or search, not for display."
    },
    "ai_image_url": {
      "type": "string",
      "description": "Path on the live site's API that serves the image (relative, not a file). The image must be downloaded separately."
    },
    "ai_image_gcs": {
      "type": "string",
      "pattern": "^gs://",
      "description": "Internal cloud-storage location of the image. Internal detail; do not publish."
    },
    "ai_metadata": {
      "type": "object",
      "description": "Generation provenance (models, prompts, session ids, timestamps). Internal detail; do not publish as-is.",
      "properties": {
        "image_enqueue": { "$ref": "#/$defs/statusEvent" },
        "image_generation": { "$ref": "#/$defs/generationEvent" },
        "recipe_generation": { "$ref": "#/$defs/generationEvent" },
        "stock_image_generation": { "type": ["object", "null"] }
      },
      "additionalProperties": true
    },
    "user_id": {
      "type": ["string", "null"],
      "description": "Owner id on the live site. Internal detail; do not publish."
    }
  },
  "required": ["id", "name", "ingredients", "instructions"],
  "$defs": {
    "ingredient": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "amount": { "type": "number", "minimum": 0 },
        "units": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["name", "amount"],
      "additionalProperties": true
    },
    "instructionStep": {
      "type": "object",
      "properties": {
        "step": { "type": "integer", "minimum": 1 },
        "description": { "type": "string", "minLength": 1 }
      },
      "required": ["step", "description"],
      "additionalProperties": true
    },
    "statusEvent": {
      "type": "object",
      "properties": {
        "status": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "additionalProperties": true
    },
    "generationEvent": {
      "type": "object",
      "properties": {
        "model": { "type": "string" },
        "prompt": { "type": "string" },
        "session_id": { "type": "string" },
        "success": { "type": "boolean" },
        "timestamp": { "type": "string" },
        "is_authenticated": { "type": "boolean" },
        "user_display_name": { "type": "string" },
        "user_id": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    }
  }
}
